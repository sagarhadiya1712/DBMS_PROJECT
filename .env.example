# Vehicle Rental & Fleet Management System - Environment Variables

# Server Config
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vehiclerental?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_super_secure_987213
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_super_secure_561243
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payments (Razorpay Sandbox/Test Mode)
# Replace with your test credentials if available; mock sandbox handler active by default
RAZORPAY_KEY_ID=rzp_test_mock_1234567890
RAZORPAY_KEY_SECRET=mock_razorpay_secret_key_abcdef

# Optional: Stripe (modular switchable)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_12345

# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_mailer_user@ethereal.email
SMTP_PASS=mock_mailer_pass
EMAIL_FROM="FleetRentals <notifications@fleetrentals.com>"

# SMS (Twilio Mock)
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary / File Upload
# Leave blank to use local server storage in /uploads folder
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./uploads

# Client Config
VITE_API_URL=http://localhost:5000/api
