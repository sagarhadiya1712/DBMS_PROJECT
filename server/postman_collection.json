{
  "info": {
    "_postman_id": "fleet-rental-better-sqlite3-postman-collection",
    "name": "Vehicle Rental & Fleet Management System API",
    "description": "Comprehensive REST API Collection covering Auth (OTP, JWT, Google), Fleet, Zero Double-Booking, Payments (Razorpay), Reports (PDF & Excel), and Compliance Alerts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (Trigger OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Mehta\",\n  \"phone\": \"+91 9988776655\",\n  \"email\": \"rohan@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "Verify 6-Digit OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-otp"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rental.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@rental.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Authenticated Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Get All Vehicles (With Filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vehicles?category=SUV&fuel_type=Diesel&sort=price_asc",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles"],
              "query": [
                { "key": "category", "value": "SUV" },
                { "key": "fuel_type", "value": "Diesel" },
                { "key": "sort", "value": "price_asc" }
              ]
            }
          }
        },
        {
          "name": "Get Vehicle Details by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/vehicles/1",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles", "1"]
            }
          }
        },
        {
          "name": "Admin: Create Vehicle",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carens Prestige\",\n  \"brand\": \"Kia\",\n  \"category\": \"MUV\",\n  \"fuel_type\": \"Diesel\",\n  \"transmission\": \"Automatic\",\n  \"seats\": 7,\n  \"price_per_day\": 3500,\n  \"price_per_hour\": 300,\n  \"price_per_km\": 18,\n  \"security_deposit\": 5000,\n  \"status\": \"Available\",\n  \"is_chauffeur_driven\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking (Zero Double-Booking Check)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"start_datetime\": \"2026-11-01T10:00:00Z\",\n  \"end_datetime\": \"2026-11-04T10:00:00Z\",\n  \"pricing_type\": \"day\",\n  \"discount_code\": \"WELCOME10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Get My Bookings (Customer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/my",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "my"]
            }
          }
        },
        {
          "name": "Admin: Approve Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "1", "approve"]
            }
          }
        },
        {
          "name": "Admin: Complete Booking & Return",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual_return_datetime\": \"2026-11-04T12:00:00Z\",\n  \"extra_fee\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/1/complete",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "1", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create-order",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "create-order"]
            }
          }
        },
        {
          "name": "Verify Razorpay Payment Signature",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1,\n  \"razorpay_order_id\": \"order_demo_101\",\n  \"razorpay_payment_id\": \"pay_demo_101\",\n  \"razorpay_signature\": \"simulated_valid_signature_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/verify",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "verify"]
            }
          }
        },
        {
          "name": "Download PDF Invoice",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/invoice/1",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "invoice", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Fleet & Compliance",
      "item": [
        {
          "name": "Get 15-Day Expiry Alerts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/fleet/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["fleet", "alerts"]
            }
          }
        },
        {
          "name": "Get Maintenance Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/fleet/maintenance",
              "host": ["{{baseUrl}}"],
              "path": ["fleet", "maintenance"]
            }
          }
        },
        {
          "name": "Get Chauffeur Drivers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/fleet/drivers",
              "host": ["{{baseUrl}}"],
              "path": ["fleet", "drivers"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Admin Overview Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats"]
            }
          }
        },
        {
          "name": "Revenue Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/revenue?range=daily",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "revenue"],
              "query": [{ "key": "range", "value": "daily" }]
            }
          }
        },
        {
          "name": "Export Fleet Report to Excel (.xlsx)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/export?type=excel",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export"],
              "query": [{ "key": "type", "value": "excel" }]
            }
          }
        },
        {
          "name": "Export Fleet Report to PDF (.pdf)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/export?type=pdf",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export"],
              "query": [{ "key": "type", "value": "pdf" }]
            }
          }
        }
      ]
    }
  ]
}
