{
  "name": "vehicle-rental-system",
  "version": "1.0.0",
  "description": "Vehicle Rental & Fleet Management System Monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node start-dev.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "seed": "npm --prefix server run db:seed",
    "test": "npm --prefix server test"
  },
  "trustedDependencies": [
    "@prisma/client",
    "prisma",
    "@prisma/engines"
  ],
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
